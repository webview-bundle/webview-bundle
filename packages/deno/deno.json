{
  "name": "@wvb/deno",
  "version": "0.0.0",
  "license": "MIT",
  "exports": {
    ".": "./lib/mod.ts",
    "./install": "./lib/install.ts",
    "./desktop": "./lib/desktop/mod.ts"
  },
  "tasks": {
    "check": "deno check lib/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-ffi --allow-read --allow-env --allow-write --allow-net",
    "build": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build.ts"
  },
  "publish": {
    "exclude": ["fixtures", "scripts", "lib/testing.ts", "**/*.test.ts"]
  },
  "imports": {
    "@denosaurs/plug": "jsr:@denosaurs/plug@^1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/async": "jsr:@std/async@^1.5.0"
  }
}
