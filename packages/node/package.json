{
  "name": "@wvb/node",
  "version": "0.1.0",
  "description": "Webview bundle API for Node.js",
  "homepage": "https://github.com/webview-bundle/webview-bundle",
  "bugs": {
    "url": "https://github.com/webview-bundle/webview-bundle/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Seokju Na",
    "email": "seokju.me@gmail.com",
    "url": "https://github.com/seokju-na"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webview-bundle/webview-bundle",
    "directory": "packages/node"
  },
  "files": [
    "dist/",
    "binding.cjs",
    "binding.d.cts",
    "README.md",
    "CHANGELOG.md",
    "!*.node",
    "!artifacts/**/*",
    "!npm/**/*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./binding": {
      "import": "./dist/binding/index.js",
      "require": "./dist/binding/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "artifacts": "node scripts/artifacts.ts",
    "build": "tsdown",
    "build-napi": "node scripts/build-napi.ts",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.11",
    "@napi-rs/cli": "3.1.5",
    "@types/node": "catalog:",
    "@types/yargs": "^17.0.35",
    "get-port": "^7.1.0",
    "hono": "^4.12.25",
    "tinyglobby": "^0.2.14",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "@wvb/node-android-arm-eabi": "workspace:^",
    "@wvb/node-android-arm64": "workspace:^",
    "@wvb/node-darwin-arm64": "workspace:^",
    "@wvb/node-darwin-x64": "workspace:^",
    "@wvb/node-linux-arm-gnueabihf": "workspace:^",
    "@wvb/node-linux-arm64-gnu": "workspace:^",
    "@wvb/node-linux-arm64-musl": "workspace:^",
    "@wvb/node-linux-x64-gnu": "workspace:^",
    "@wvb/node-linux-x64-musl": "workspace:^",
    "@wvb/node-win32-arm64-msvc": "workspace:^",
    "@wvb/node-win32-ia32-msvc": "workspace:^",
    "@wvb/node-win32-x64-msvc": "workspace:^"
  },
  "napi": {
    "binaryName": "wvb-node",
    "targets": [
      "i686-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-linux-android",
      "armv7-linux-androideabi"
    ]
  },
  "engines": {
    "node": ">= 18"
  }
}
