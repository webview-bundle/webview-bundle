    "test": "vitest run"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.5.2",
    "@types/node": "catalog:",
    "clipanion": "4.0.0-rc.4",
    "kleur": "4.1.5",
    "tsdown": "catalog:",
    "typanion": "3.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
