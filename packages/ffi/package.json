{
  "name": "wvb-ffi",
  "private": true,
  "type": "module",
  "scripts": {
    "build-ffi": "yarn build-ffi-android && yarn build-ffi-apple",
    "build-ffi-android": "node ./cli/main.ts build android --profile=release",
    "build-ffi-apple": "node ./cli/main.ts build apple --profile=release",
    "test-ffi": "yarn test-ffi-android && yarn test-ffi-apple",
    "test-ffi-android": "node ./cli/main.ts test android",
    "test-ffi-apple": "node ./cli/main.ts test apple",
    "e2e-ffi": "e2e run",
    "e2e-ffi-android": "e2e run --target android",
    "e2e-ffi-apple": "e2e run --target apple",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "0.9.1",
    "@ltd/j-toml": "^1.38.0",
    "@types/yazl": "^3",
    "agent-device": "0.21.18",
    "clipanion": "4.0.0-rc.4",
    "e2e": "0.16.0",
    "execa": "^9",
    "tinyglobby": "^0.2.14",
    "typanion": "^3.14.0",
    "typescript": "catalog:",
    "yazl": "^3.3.1",
    "zod": "^4.0.5"
  }
}
